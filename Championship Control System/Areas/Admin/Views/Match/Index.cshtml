@model IEnumerable<Championship_Control_System.Models.Match>
@using Championship_Control_System.Enums

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold"><i class="bi bi-calendar-event me-2"></i>Match Fixtures</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> New Match
        </a>
    </div>

    <div class="card shadow-sm border-0 bg-body-tertiary">
        @* استخدام bg-body-tertiary للتوافق مع الثيم *@
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-body-secondary">
                        @* رأس جدول يتغير لونه *@
                        <tr class="text-secondary small uppercase">
                            <th class="ps-4">Tournament</th>
                            <th>Schedule</th>
                            <th class="text-center" style="width: 35%;">Matchup</th>
                            <th>Venue</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-body">@item.Championship?.ChampionshipName</div>
                                    <div class="text-secondary small">@item.Championship?.Season</div>
                                </td>

                                <td>
                                    <div class="text-body fw-semibold">@item.MatchDate?.ToString("dd MMM yyyy")</div>
                                    <div class="text-secondary small">@item.MatchDate?.ToString("hh:mm tt")</div>
                                </td>

                                <td>
                                    @* صندوق المباراة - خلفية شفافة في الدارك مود ومميزة في اللايت مود *@
                                    <div class="d-flex align-items-center justify-content-between bg-body-secondary rounded-pill p-1 px-3 border border-secondary-subtle">
                                        <div class="text-end flex-grow-1">
                                            <span class="fw-bold text-body text-truncate d-block" style="max-width: 120px;">@item.HomeTeam?.TeamName</span>
                                        </div>

                                        <div class="mx-3">
                                            @if (item.Status == MatchStatus.Completed || item.Status == MatchStatus.Live)
                                            {
                                                <span class="badge rounded-pill bg-primary px-3 shadow-sm">
                                                    @(item.HomeGoals ?? 0) - @(item.AwayGoals ?? 0)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="small fw-bold text-secondary">VS</span>
                                            }
                                        </div>

                                        <div class="text-start flex-grow-1">
                                            <span class="fw-bold text-body text-truncate d-block" style="max-width: 120px;">@item.AwayTeam?.TeamName</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="text-body small"><i class="bi bi-geo-alt me-1 text-primary"></i>@item.Stadium?.StadiumName</div>
                                    <div class="text-secondary small ms-3">@item.Stadium?.City</div>
                                </td>

                                <td class="text-center">
                                    @* استخدام الألوان بصيغة subtle لتكون مريحة للعين في الدارك مود *@
                                    @switch (item.Status)
                                    {
                                        case MatchStatus.Live:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle animate-pulse px-3">
                                                <i class="bi bi-record-fill me-1"></i> LIVE
                                            </span>
                                            break;
                                        case MatchStatus.Completed:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Finished</span>
                                            break;
                                        case MatchStatus.Postponed:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3">Postponed</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">Scheduled</span>
                                            break;
                                    }
                                </td>

                                <td class="text-center pe-4">
                                    <div class="btn-group border rounded shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.MatchId" class="btn btn-sm btn-link text-body border-end" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-controller="MatchEvent" asp-action="Index" asp-route-matchId="@item.MatchId" class="btn btn-sm btn-link text-info border-end" title="Events">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MatchId" class="btn btn-sm btn-link text-danger" title="Delete" onclick="return confirm('Delete match?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>