@model Championship_Control_System.Models.MatchEvent

@{
    ViewData["Title"] = "Create Match Event";
}

<h2>Create Match Event</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Minute" class="form-label"></label>
        <input asp-for="Minute" class="form-control" />
        <span asp-validation-for="Minute" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-control">
            <option value="">-- Select Event Type --</option>
            <option>Goal</option>
            <option>Yellow Card</option>
            <option>Red Card</option>
            <option>Substitution</option>
        </select>
        <span asp-validation-for="EventType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Match</label>
        <select asp-for="MatchId" asp-items="ViewBag.Matches" class="form-control">
            <option value="">-- Select Match --</option>
        </select>
        <span asp-validation-for="MatchId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
