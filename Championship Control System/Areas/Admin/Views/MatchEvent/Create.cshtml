@model Championship_Control_System.Models.MatchEvent

@{
    ViewData["Title"] = "Add Event";
}

<div class="container-fluid p-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add Match Event</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="MatchId" class="form-label fw-bold">Select Match</label>
                            <select asp-for="MatchId" id="MatchSelector" class="form-select" asp-items="ViewBag.Matches">
                                <option value="">-- Select Match First --</option>
                            </select>
                            <span asp-validation-for="MatchId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Minute" class="form-label fw-bold">Minute</label>
                                <input asp-for="Minute" class="form-control" type="number" min="1" max="130" />
                                <span asp-validation-for="Minute" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EventType" class="form-label fw-bold">Event Type</label>
                                <select asp-for="EventType" class="form-select" asp-items="ViewBag.EventTypes"></select>
                                <span asp-validation-for="EventType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PlayerId" class="form-label fw-bold">Player Involved</label>
                            <select asp-for="PlayerId" class="form-select" asp-items="ViewBag.Players">
                                <option value="">-- Select Player --</option>
                            </select>
                            <span asp-validation-for="PlayerId" class="text-danger"></span>
                            <small class="text-muted">List updates based on selected match.</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-route-matchId="@Model.MatchId" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-success px-4">Create Event</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("MatchSelector").addEventListener("change", function() {
            var matchId = this.value;
            if (matchId) {
                window.location.href = '/Admin/MatchEvent/Create?matchId=' + matchId;
            }
        });
    </script>
}