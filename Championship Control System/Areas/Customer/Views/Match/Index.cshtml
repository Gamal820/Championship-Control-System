@model IEnumerable<Championship_Control_System.Models.Match>

@{
    ViewData["Title"] = "Match Schedule";
    var filter = ViewBag.Filter as string ?? "All";
}

<h2 class="text-primary fw-bold mb-4">
    Match Schedule
</h2>

<!-- FILTER BUTTONS -->
<div class="mb-4">

    <a asp-action="Index"
       asp-route-filter="All"
       class="btn @(filter=="All"?"btn-primary":"btn-outline-primary")">
        All
    </a>

    <a asp-action="Index"
       asp-route-filter="Today"
       class="btn @(filter=="Today"?"btn-primary":"btn-outline-primary")">
        Today
    </a>

    <a asp-action="Index"
       asp-route-filter="Upcoming"
       class="btn @(filter=="Upcoming"?"btn-primary":"btn-outline-primary")">
        Upcoming
    </a>

</div>


@foreach (var match in Model)
{
    <div class="card mb-3 shadow-sm p-3">

        <div class="row align-items-center text-center">

            <!-- HOME -->
            <div class="col-md-4">
                <img src="@match.HomeTeam?.Logo"
                     width="60" height="60"
                     style="object-fit:contain" />

                <h5 class="fw-bold mt-2">
                    @match.HomeTeam?.TeamName
                </h5>
            </div>

            <!-- SCORE -->
            <div class="col-md-4">

                <h4 class="fw-bold">
                    @(match.HomeGoals ?? 0)
                    -
                    @(match.AwayGoals ?? 0)
                </h4>

                <span class="text-danger">
                    @match.Status
                </span>

                <div class="text-muted">
                    @match.MatchDate?.ToString("hh:mm tt")
                </div>

            </div>

            <!-- AWAY -->
            <div class="col-md-4">
                <img src="@match.AwayTeam?.Logo"
                     width="60" height="60"
                     style="object-fit:contain" />

                <h5 class="fw-bold mt-2">
                    @match.AwayTeam?.TeamName
                </h5>
            </div>

        </div>

    </div>
}
