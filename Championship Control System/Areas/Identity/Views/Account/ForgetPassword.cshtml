@model Championship_Control_System.ViewModels.ForgetPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LayoutIdentity";
}

<div class="auth-container">
    <div class="auth-header">
        <i class="bi bi-key-fill main-icon"></i>
        <h2>Forgot Password?</h2>
        <p>Don't worry, we'll help you recover it</p>
    </div>

    <div class="auth-body">
        <div class="info-box alert alert-info text-start">
            <i class="bi bi-info-circle-fill"></i>
            <span>An OTP code will be sent to your email to reset your password.</span>
        </div>

        <form asp-area="Identity" asp-controller="Account" asp-action="ForgetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-4 text-start">
                <label asp-for="UserNameOREmail" class="form-label fw-bold">Username or Email</label>
                <div class="input-group">
                    <input asp-for="UserNameOREmail" class="form-control" placeholder="Enter username or email" />
                    <span class="input-group-text"><i class="bi bi-person-circle"></i></span>
                </div>
                <span asp-validation-for="UserNameOREmail" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100">
                <i class="bi bi-send"></i> Send OTP Code
            </button>

            <div class="text-center mt-4">
                <p class="mb-0">
                    Remembered your password?
                    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="link-text">
                        <i class="bi bi-box-arrow-in-left"></i> Login
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>