@model IEnumerable<Championship_Control_System.Models.CartItem>

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "My Cart";
    var items = Model?.ToList() ?? new List<Championship_Control_System.Models.CartItem>();
    var subtotal = items.Sum(x => x.Price * x.Count);
    var totalCount = items.Sum(x => x.Count);
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Cart</h2>
            <div class="text-muted">
                @totalCount ticket(s) • @subtotal.ToString("0.00") EGP
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-area="Customer" asp-controller="Ticket" asp-action="Index"
               class="btn btn-outline-primary">
                <i class="fas fa-plus me-1"></i> Add More Matches
            </a>

            <a asp-area="Customer" asp-controller="Home" asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="fas fa-home me-1"></i> Home
            </a>
        </div>
    </div>
    @if (TempData["error-notification"] != null)
    {
        <div class="alert alert-danger">
            @TempData["error-notification"]
        </div>
    }

    @if (TempData["success-notification"] != null)
    {
        <div class="alert alert-success">
            @TempData["success-notification"]
        </div>
    }


    @if (!items.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="mb-3" style="font-size:52px;">🛒</div>
                <h5 class="fw-bold">Your cart is empty</h5>
                <p class="text-muted mb-3">Browse available matches and add tickets.</p>

                <a asp-area="Customer" asp-controller="Ticket" asp-action="Index"
                   class="btn btn-primary px-4">
                    Browse Matches
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: Items -->
            <div class="col-lg-8">
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in items)
                    {
                        var matchDate = item.Match?.MatchDate;
                        var day = matchDate?.Day.ToString() ?? "--";
                        var month = matchDate?.ToString("MMM") ?? "---";
                        var time = matchDate?.ToString("hh:mm tt") ?? "";
                        var stadium = item.Match?.Stadium?.StadiumName ?? "—";
                        var home = item.Match?.HomeTeam?.TeamName ?? "Home";
                        var away = item.Match?.AwayTeam?.TeamName ?? "Away";
                        var lineTotal = item.Price * item.Count;

                        <div class="card border-0 shadow-sm overflow-hidden">
                            <div class="row g-0">
                                <!-- Date block (like Book Tickets) -->
                                <div class="col-12 col-md-3 bg-primary text-white d-flex flex-column justify-content-center align-items-center py-4">
                                    <div class="display-6 fw-bold lh-1">@day</div>
                                    <div class="fw-semibold">@month</div>
                                    <div class="small opacity-75 mt-2">
                                        <i class="fas fa-clock me-1"></i>@time
                                    </div>
                                </div>

                                <!-- Details -->
                                <div class="col-12 col-md-9">
                                    <div class="card-body p-3 p-md-4">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                            <div>
                                                <h5 class="fw-bold mb-1">@home vs @away</h5>
                                                <div class="text-muted">
                                                    <i class="fas fa-map-marker-alt me-1"></i>@stadium
                                                </div>
                                            </div>

                                            <div class="text-end">
                                                <div class="text-muted small">Unit Price</div>
                                                <div class="fw-bold">@item.Price.ToString("0.00") EGP</div>
                                            </div>
                                        </div>

                                        <hr class="my-3" />

                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <!-- Quantity controls -->
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-muted">Quantity</span>

                                                <div class="btn-group" role="group" aria-label="Quantity">
                                                    <a class="btn btn-outline-secondary btn-sm"
                                                       asp-area="Customer" asp-controller="Cart" asp-action="Decrement"
                                                       asp-route-matchId="@item.MatchId">-</a>

                                                    <span class="btn btn-light btn-sm disabled" style="min-width:52px;">
                                                        @item.Count
                                                    </span>

                                                    <a class="btn btn-outline-secondary btn-sm"
                                                       asp-area="Customer" asp-controller="Cart" asp-action="Increment"
                                                       asp-route-matchId="@item.MatchId">+</a>
                                                </div>
                                            </div>

                                            <!-- Totals + remove -->
                                            <div class="d-flex align-items-center gap-3 ms-auto">
                                                <div class="text-end">
                                                    <div class="text-muted small">Line Total</div>
                                                    <div class="fw-bold">@lineTotal.ToString("0.00") EGP</div>
                                                </div>

                                                <a class="btn btn-outline-danger btn-sm"
                                                   asp-area="Customer" asp-controller="Cart" asp-action="Delete"
                                                   asp-route-matchId="@item.MatchId">
                                                    <i class="fas fa-trash me-1"></i> Remove
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm position-sticky" style="top: 90px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Order Summary</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Items</span>
                            <span class="fw-semibold">@totalCount</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-semibold">@subtotal.ToString("0.00") EGP</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Fees</span>
                            <span class="fw-semibold">0.00 EGP</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <span class="fw-bold">Total</span>
                            <span class="fw-bold">@subtotal.ToString("0.00") EGP</span>
                        </div>

                        <form asp-area="Customer" asp-controller="Cart" asp-action="Pay" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100">
                                Pay with Stripe
                            </button>
                        </form>




                        <div class="text-muted small mt-3">
                            * Checkout will be enabled when you implement ticket confirmation/payment.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* لمسة بسيطة للكروت */
    .card {
        border-radius: 14px;
    }

    .btn {
        border-radius: 10px;
    }

    .table {
        border-radius: 14px;
        overflow: hidden;
    }
</style>
