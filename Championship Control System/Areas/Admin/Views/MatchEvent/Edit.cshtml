@model Championship_Control_System.Models.MatchEvent

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container-fluid p-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Match Event</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="EventId" />
                        <input type="hidden" asp-for="MatchId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Match</label>
                            <select disabled class="form-select" asp-items="ViewBag.Matches">
                                <option value="@Model.MatchId" selected></option>
                            </select>
                            <small class="text-muted">Cannot change match during edit to preserve data integrity.</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Minute" class="form-label fw-bold">Minute</label>
                                <input asp-for="Minute" class="form-control" type="number" min="1" />
                                <span asp-validation-for="Minute" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EventType" class="form-label fw-bold">Event Type</label>
                                <select asp-for="EventType" class="form-select" asp-items="ViewBag.EventTypes"></select>
                                <span asp-validation-for="EventType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PlayerId" class="form-label fw-bold">Player</label>
                            <select asp-for="PlayerId" class="form-select" asp-items="ViewBag.Players">
                                <option value="">-- Select Player --</option>
                            </select>
                            <span asp-validation-for="PlayerId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-route-matchId="@Model.MatchId" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-warning px-4">Update Event</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}