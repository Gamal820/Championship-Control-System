@{
    ViewData["Title"] = "Home";
    var matches = ViewBag.TodayMatches as IEnumerable<Championship_Control_System.Models.Match>;
    var standings = ViewBag.Standings;
}

<!-- ================= HERO SECTION ================= -->
<section class="hero-section text-center text-white d-flex align-items-center justify-content-center"
         style="height:350px;background:#6c757d;border-radius:15px;margin-bottom:30px;">

    <div>
        <h1 class="display-5 fw-bold">Enjoy the Top Championships</h1>
        <p class="lead">
            Live results, accurate statistics, and easy ticket booking.
        </p>

        <a href="#" class="btn btn-warning btn-lg fw-bold">
            Book Your Ticket Now
        </a>
    </div>
</section>


<div class="row">

    <!-- ================= TODAY MATCHES ================= -->
    <div class="col-md-8">

        <h4 class="mb-3">
            <i class="bi bi-clock text-danger"></i>
            Today's Matches
        </h4>

        @if (matches != null && matches.Any())
        {
            foreach (var match in matches)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">

                        <!-- Home Team -->
                        <div class="text-center" style="width:40%">
                            <img src="@match.HomeTeam?.Logo"
                                 width="50" height="50"
                                 class="mb-2" />
                            <h6>@match.HomeTeam?.TeamName</h6>
                        </div>

                        <!-- Score -->
                        <div class="text-center">
                            <span class="badge bg-danger mb-2">
                                @match.Status
                            </span>

                            <h4 class="fw-bold">
                                @(match.HomeGoals ?? 0)
                                -
                                @(match.AwayGoals ?? 0)
                            </h4>
                        </div>

                        <!-- Away Team -->
                        <div class="text-center" style="width:40%">
                            <img src="@match.AwayTeam?.Logo"
                                 width="50" height="50"
                                 class="mb-2" />
                            <h6>@match.AwayTeam?.TeamName</h6>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                No matches today.
            </div>
        }

    </div>


    <!-- ================= LEAGUE STANDINGS ================= -->
    <div class="col-md-4">

        <h4 class="mb-3">
            <i class="bi bi-list-ol text-primary"></i>
            League Standings
        </h4>

        <div class="card shadow-sm">
            <div class="card-body p-0">

                <table class="table table-striped mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Team</th>
                            <th>Played</th>
                            <th>Points</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int rank = 1;
                        }

                        @if (standings != null)
                        {
                            foreach (var team in standings)
                            {
                                <tr>
                                    <td>@rank</td>
                                    <td>@team.TeamName</td>
                                    <td>@team.Played</td>
                                    <td class="fw-bold">
                                        @team.Points
                                    </td>
                                </tr>

                                rank++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">
                                    No standings available.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

    </div>

</div>
