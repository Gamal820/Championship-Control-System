@model Championship_Control_System.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Create New Account";
    Layout = "_LayoutIdentity";
}

<div class="auth-container">
    <div class="auth-header">
        <i class="bi bi-person-plus-fill main-icon"></i>
        <h2>Create New Account</h2>
        <p>Join us today!</p>
    </div>

    <div class="auth-body">
        <form asp-area="Identity" asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row row-cols-1 row-cols-md-2 g-3 mb-3 text-start">
                <div>
                    <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                    <div class="input-group">
                        <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                    </div>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                    <div class="input-group">
                        <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                    </div>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3 text-start">
                <label asp-for="UserName" class="form-label fw-bold">Username</label>
                <div class="input-group">
                    <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                    <span class="input-group-text"><i class="bi bi-at"></i></span>
                </div>
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3 text-start">
                <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                <div class="input-group">
                    <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" />
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3 text-start">
                <label asp-for="Password" class="form-label fw-bold">Password</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 text-start">
                <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm Password</label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100">
                <i class="bi bi-check-circle"></i> Create Account
            </button>

            <div class="text-center mt-4">
                <p class="mb-0">
                    Already have an account?
                    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="link-text">
                        <i class="bi bi-box-arrow-in-left"></i> Login
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>