@using Championship_Control_System.Utitlies
@using Microsoft.AspNetCore.Identity

<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <a href="/" class="sidebar-brand">
            <i class="bi bi-trophy-fill me-2"></i>
            <span>Championship Pro</span>
        </a>
        <button class="sidebar-toggle d-lg-none" id="sidebarClose">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="sidebar-menu">
        <ul class="nav flex-column">

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            @if (User.IsInRole(SD.SuperAdminRole) || User.IsInRole(SD.TournamentManagerRole) || User.IsInRole(SD.TeamManagerRole))
            {
                <li class="nav-header">Tournament Core</li>
            }

            @if (User.IsInRole(SD.SuperAdminRole) || User.IsInRole(SD.TournamentManagerRole))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Championship" ? "active" : "")" asp-controller="Championship" asp-action="Index">
                        <i class="bi bi-award"></i>
                        <span>Tournaments & Leagues</span>
                    </a>
                </li>
            }

            @if (User.IsInRole(SD.SuperAdminRole) || User.IsInRole(SD.TeamManagerRole))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stadium" ? "active" : "")" asp-controller="Stadium" asp-action="Index">
                        <i class="bi bi-geo-alt"></i>
                        <span>Stadiums & Venues</span>
                    </a>
                </li>
            }

            @if (User.IsInRole(SD.SuperAdminRole) || User.IsInRole(SD.TeamManagerRole))
            {
                <li class="nav-header">Participants Management</li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Team" ? "active" : "")" asp-controller="Team" asp-action="Index">
                        <i class="bi bi-shield-shaded"></i>
                        <span>Teams</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Player" ? "active" : "")" asp-controller="Player" asp-action="Index">
                        <i class="bi bi-people-fill"></i>
                        <span>Players</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Championship" ? "active" : "")"
                       asp-controller="Championship" asp-action="Index">
                        <i class="bi bi-trophy-fill"></i>
                        <span>Championship</span>
                    </a>
                </li>


                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Coach" ? "active" : "")" asp-controller="Coach" asp-action="Index">
                        <i class="bi bi-person-badge-fill"></i> <span>Coaches</span>
                    </a>
                </li>
            }

            @if (User.IsInRole(SD.SuperAdminRole) || User.IsInRole(SD.TournamentManagerRole))
            {
                <li class="nav-header">Match Center</li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Match" ? "active" : "")" asp-controller="Match" asp-action="Index">
                        <i class="bi bi-calendar-event"></i>
                        <span>Match Fixtures</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MatchEvent" ? "active" : "")" asp-controller="MatchEvent" asp-action="Index">
                        <i class="bi bi-card-list"></i>
                        <span>Match Events & Scores</span>
                    </a>
                </li>
            }

            @if (User.IsInRole(SD.SuperAdminRole))
            {
                <li class="nav-header">Administration</li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")" asp-controller="User" asp-action="Index">
                        <i class="bi bi-person-lock"></i>
                        <span>User Access (RBAC)</span>
                    </a>
                </li>
            }
            <li class="nav-item mt-3">
                <hr class="dropdown-divider bg-light opacity-25 mx-3">
            </li>

            <li class="nav-item">
                <a class="nav-link text-warning" asp-area="Customer" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-globe"></i> <span>Go to Website</span>
                    <i class="bi bi-box-arrow-up-right ms-auto small"></i>
                </a>
            </li>

        </ul>
    </div>

    <div class="sidebar-footer">
        <div class="d-flex align-items-center">
            <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=1e293b&color=fff" alt="@User.Identity.Name" class="rounded-circle me-2" width="32" height="32">
            <div class="flex-grow-1">
                <small class="d-block text-white">@User.Identity.Name</small>
            </div>
        </div>
    </div>
</aside>