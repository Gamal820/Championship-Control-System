@model Championship_Control_System.ViewModels.NewPasswordVM
@{
    ViewData["Title"] = "Set New Password";
    Layout = "_LayoutIdentity";
}

@section Styles {
    <style>
        .password-requirements {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
            font-size: 13px;
        }

            .password-requirements h6 {
                color: #667eea;
                font-weight: bold;
                margin-bottom: 10px;
            }

            .password-requirements ul {
                margin: 0;
                padding-left: 20px;
            }

            .password-requirements li {
                margin-bottom: 5px;
            }

        .input-group-text {
            cursor: pointer;
        }
    </style>
}

<div class="auth-container">
    <div class="auth-header">
        <i class="bi bi-lock-fill main-icon"></i>
        <h2>Set New Password</h2>
        <p>Choose a strong and secure password</p>
    </div>

    <div class="auth-body">
        <div class="password-requirements text-start">
            <h6><i class="bi bi-info-circle"></i> Password Requirements:</h6>
            <ul>
                <li>At least 6 characters long</li>
                <li>One uppercase and one lowercase letter</li>
                <li>At least one number</li>
                <li>One special character (!@@#$%)</li>
            </ul>
        </div>

        <form asp-area="Identity" asp-controller="Account" asp-action="NewPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ApplicationUserId" />

            <div class="mb-3 text-start">
                <label asp-for="Password" class="form-label fw-bold">New Password</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control" id="password" placeholder="New Password" />
                    <span class="input-group-text" onclick="togglePassword('password', this)">
                        <i class="bi bi-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 text-start">
                <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm Password</label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPassword" placeholder="Confirm Password" />
                    <span class="input-group-text" onclick="togglePassword('confirmPassword', this)">
                        <i class="bi bi-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100">
                <i class="bi bi-check-circle"></i> Update Password
            </button>

            <div class="text-center mt-4">
                <p class="mb-0">
                    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="link-text">
                        <i class="bi bi-box-arrow-in-left"></i> Back to Login
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>