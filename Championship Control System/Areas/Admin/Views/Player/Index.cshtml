@model IEnumerable<Championship_Control_System.Models.Player>

@{
    ViewData["Title"] = "Players Management";
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-people-fill me-2"></i>Registered Players
        </h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Player
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th class="ps-4">Player</th>
                            <th>Nationality</th>
                            <th>Position</th>
                            <th>Shirt #</th>
                            <th>Current Team</th>
                            <th>Age</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.Img))
                                        {
                                            <img src="@item.Img" alt="Player" class="rounded-circle me-3" style="width: 45px; height: 45px; object-fit: cover; border: 2px solid #eee;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                                <i class="bi bi-person text-white"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold">@item.Fname @item.Lname</div>
                                            <small class="text-muted">ID: #@item.PlayerId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@item.Nationality</span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark fw-normal">@item.Position</span>
                                </td>
                                <td class="fw-bold text-primary">
                                    @(item.ShirtNumber.HasValue? item.ShirtNumber.Value.ToString("00") : "--")
                                </td>
                                <td>
                                    @if (item.Team != null)
                                    {
                                        <div class="d-flex align-items-center text-dark">
                                            @if (!string.IsNullOrEmpty(item.Team.Logo))
                                            {
                                                <img src="@item.Team.Logo" class="me-2" style="width: 25px; height: 25px; object-fit: contain;" />
                                            }
                                            @item.Team.TeamName
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-danger small italic">Free Agent</span>
                                    }
                                </td>
                                <td>
                                    @if (item.BirthDate.HasValue)
                                    {
                                        var age = DateTime.Now.Year - item.BirthDate.Value.Year;
                                        <span>@age Years</span>
                                    }
                                    else
                                    {
                                        <span>--</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.PlayerId" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.PlayerId" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>