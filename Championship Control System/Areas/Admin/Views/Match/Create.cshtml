@model Championship_Control_System.Models.Match

@{
    ViewData["Title"] = "Create Match";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-calendar-plus me-2"></i>Schedule New Match
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MatchDate" class="form-label fw-bold">Match Date</label>
                                <input asp-for="MatchDate" type="datetime-local" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-bold">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option>Scheduled</option>
                                    <option>Finished</option>
                                    <option>Cancelled</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Home Team</label>
                                <select asp-for="HomeTeamId" class="form-select" asp-items="ViewBag.Teams"></select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Away Team</label>
                                <select asp-for="AwayTeamId" class="form-select" asp-items="ViewBag.Teams"></select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stadium</label>
                                <select asp-for="StadiumId" class="form-select" asp-items="ViewBag.Stadiums"></select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Championship</label>
                                <select asp-for="ChampionshipId" class="form-select" asp-items="ViewBag.Championships"></select>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Match
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
