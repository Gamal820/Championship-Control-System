@model IEnumerable<Championship_Control_System.Models.Match>
@using Championship_Control_System.Enums

@{
    ViewData["Title"] = "Match Schedule";
    var filter = ViewBag.Filter as string ?? "All";
}

<h2 class="text-primary fw-bold mb-4">Match Schedule</h2>

<!-- FILTER BUTTONS -->
<div class="mb-4 d-flex gap-2">
    <a asp-action="Index" asp-route-filter="All"
       class="btn @(filter == "All" ? "btn-primary" : "btn-outline-primary") shadow-sm">All</a>

    <a asp-action="Index" asp-route-filter="Today"
       class="btn @(filter == "Today" ? "btn-primary" : "btn-outline-primary") shadow-sm">Today</a>

    <a asp-action="Index" asp-route-filter="Upcoming"
       class="btn @(filter == "Upcoming" ? "btn-primary" : "btn-outline-primary") shadow-sm">Upcoming</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No matches found for this selection.</div>
}
else
{
    @foreach (var match in Model)
    {
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-body">
                <div class="row align-items-center text-center">

                    <!-- HOME TEAM -->
                    <div class="col-md-4 col-5">
                        <img src="@(string.IsNullOrEmpty(match.HomeTeam?.Logo) ? "/images/default-team.png" : match.HomeTeam.Logo)"
                             width="60" height="60" style="object-fit:contain" class="mb-2" />
                        <h6 class="fw-bold">@match.HomeTeam?.TeamName</h6>
                    </div>

                    <!-- SCORE & STATUS -->
                    <div class="col-md-4 col-2">
                        @if (match.Status == MatchStatus.Scheduled)
                        {
                            <h4 class="fw-bold">VS</h4>
                        }
                        else
                        {
                            <h3 class="fw-bold mb-0">
                                @(match.HomeGoals ?? 0) - @(match.AwayGoals ?? 0)
                            </h3>
                        }

                        <div class="badge @GetStatusClass(match.Status) mb-1">
                            @match.Status
                        </div>

                        <div class="text-muted small">
                            <i class="bi bi-clock"></i> @match.MatchDate?.ToString("dd MMM | hh:mm tt")
                        </div>
                    </div>

                    <!-- AWAY TEAM -->
                    <div class="col-md-4 col-5">
                        <img src="@(string.IsNullOrEmpty(match.AwayTeam?.Logo) ? "/images/default-team.png" : match.AwayTeam.Logo)"
                             width="60" height="60" style="object-fit:contain" class="mb-2" />
                        <h6 class="fw-bold">@match.AwayTeam?.TeamName</h6>
                    </div>

                </div>
            </div>
        </div>
    }
}

@functions {
    // وظيفة مساعدة لتلوين حالة المباراة
    public string GetStatusClass(MatchStatus status) => status switch
    {
        MatchStatus.Live => "bg-danger",
        MatchStatus.Completed => "bg-secondary",
        MatchStatus.Scheduled => "bg-success",
        MatchStatus.Postponed => "bg-warning text-dark",
        _ => "bg-dark"
    };
}