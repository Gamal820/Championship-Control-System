@model IEnumerable<Championship_Control_System.Models.MatchEvent>

@{
    ViewData["Title"] = "Match Events";
    int? selectedMatchId = ViewBag.SelectedMatchId;
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary"><i class="bi bi-stopwatch me-2"></i>Match Events</h2>
            @if (selectedMatchId != null && Model.Any())
            {
                var firstEvent = Model.First();
                <h5 class="text-muted">
                    @firstEvent.Match?.HomeTeam?.TeamName vs @firstEvent.Match?.AwayTeam?.TeamName
                </h5>
            }
        </div>
        <div>
            @if (selectedMatchId != null)
            {
                <a asp-controller="Match" asp-action="Index" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-arrow-left"></i> Back to Matches
                </a>
            }
            <a asp-action="Create" asp-route-matchId="@selectedMatchId" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Event
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                    <p>No events found for this match yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Minute</th>
                                <th>Type</th>
                                <th>Player</th>
                                <th>Team (Inferred)</th> @if (selectedMatchId == null)
                                {
                                    <th>Match</th>
                                }
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Minute'</td>

                                    <td>
                                        @if (item.EventType == "Goal")
                                        {
                                            <span class="badge bg-success rounded-pill px-3"><i class="bi bi-circle-fill me-1"></i> Goal</span>
                                        }
                                        else if (item.EventType == "YellowCard")
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3"><i class="bi bi-square-fill me-1"></i> Yellow Card</span>
                                        }
                                        else if (item.EventType == "RedCard")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3"><i class="bi bi-square-fill me-1"></i> Red Card</span>
                                        }
                                        else if (item.EventType == "Substitution")
                                        {
                                            <span class="badge bg-info text-dark rounded-pill px-3"><i class="bi bi-arrow-left-right me-1"></i> Sub</span>
                                        }
                                        else if (item.EventType == "Penalty")
                                        {
                                            <span class="badge bg-dark rounded-pill px-3">Penalty</span>
                                        }
                                        else if (item.EventType == "OwnGoal")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3">Own Goal</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.EventType</span>
                                        }
                                    </td>

                                    <td class="fw-semibold">
                                        @if (item.Player != null)
                                        {
                                            <span>@item.Player.Fname @item.Player.Lname</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Unknown</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Player?.TeamId == item.Match?.HomeTeamId)
                                        {
                                            <span class="text-primary">Home</span>
                                        }
                                        else if (item.Player?.TeamId == item.Match?.AwayTeamId)
                                        {
                                            <span class="text-danger">Away</span>
                                        }
                                    </td>

                                    @if (selectedMatchId == null)
                                    {
                                        <td>
                                            <small>@item.Match?.HomeTeam?.TeamName vs @item.Match?.AwayTeam?.TeamName</small>
                                            <div class="text-muted" style="font-size: 0.8rem;">@item.Match?.MatchDate?.ToShortDateString()</div>
                                        </td>
                                    }

                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this event?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>