@model IEnumerable<Championship_Control_System.Models.Match>

@{
    ViewData["Title"] = "Manage Matches";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-controller me-2"></i>Match Fixtures</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Schedule New Match
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>Championship</th>
                            <th>Date</th>
                            <th>Home Team</th>
                            <th>Away Team</th>
                            <th>Ticket Price</th>
                            <th>Available Tickets</th>
                            <th style="width: 35%;">Matchup</th>
                            <th>Stadium</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MatchDate?.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold">@item.HomeTeam?.TeamName</td>
                                <td class="fw-bold">@item.AwayTeam?.TeamName</td>
                                <td class="fw-bold">@item.TicketPrice</td>
                                <td class="fw-bold">@item.AvailableTicket</td>
                                <td class="fw-bold text-secondary">
                                    @Html.DisplayFor(modelItem => item.Championship.ChampionshipName)
                                </td>

                                <td>
                                    @if (item.MatchDate.HasValue)
                                    {
                                        <div class="fw-bold">@item.MatchDate.Value.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@item.MatchDate.Value.ToString("hh:mm tt")</small>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-between align-items-center px-2">
                                        <div class="text-end w-50 pe-2">
                                            <span class="fw-bold">@item.HomeTeam?.TeamName</span>
                                        </div>

                                        <div class="text-center px-2">
                                            @if (item.Status == "Finished" || item.Status == "Live")
                                            {
                                                <span class="badge bg-dark fs-6">@item.HomeGoals - @item.AwayGoals</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark font-monospace">VS</span>
                                            }
                                        </div>

                                        <div class="text-start w-50 ps-2">
                                            <span class="fw-bold">@item.AwayTeam?.TeamName</span>
                                        </div>
                                    </div>
                                </td>

                                <td>@item.Stadium?.StadiumName</td>

                                <td>
                                    @if (item.Status == "Finished")
                                    {
                                        <span class="badge bg-success">Finished</span>
                                    }
                                    else if (item.Status == "Live")
                                    {
                                        <span class="badge bg-danger spinner-grow-sm">Live</span>
                                    }
                                    else if (item.Status == "Postponed")
                                    {
                                        <span class="badge bg-warning text-dark">Postponed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Upcoming</span>
                                    }
                                </td>

                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.MatchId" class="btn btn-sm btn-outline-warning" title="Edit Result">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-controller="MatchEvent" asp-action="Index" asp-route-matchId="@item.MatchId" class="btn btn-sm btn-outline-info" title="Manage Events">
                                            <i class="bi bi-stopwatch-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MatchId" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this match?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>