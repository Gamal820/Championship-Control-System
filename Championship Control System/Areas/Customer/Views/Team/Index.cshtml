@{
    ViewData["Title"] = "Clubs";
}

<h3 class="fw-bold text-primary mb-4">Participating Clubs</h3>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    <!-- Team Card -->
    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3 hover-shadow" style="transition: 0.3s;">
            <div class="py-4">
                <img src="/images/teams/ahly.png" style="width: 100px; height: 100px; object-fit: contain;" alt="Team Logo">
            </div>
            <div class="card-body">
                <h5 class="card-title fw-bold">Al Ahly SC</h5>
                <p class="text-muted small">Cairo International Stadium</p>
                <a href="/Customer/Team/Details/1" class="btn btn-outline-primary btn-sm rounded-pill px-4">View Profile</a>
            </div>
        </div>
    </div>
    <!-- Repeat other teams here -->
</div>
