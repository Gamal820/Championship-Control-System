@model Championship_Control_System.Models.Championship

@{
    ViewData["Title"] = Model.ChampionshipName + " Standings";
}

<div class="container py-5">
    <!-- Header Section -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Leagues</a></li>
            <li class="breadcrumb-item active">@Model.ChampionshipName</li>
        </ol>
    </nav>

    <div class="bg-white rounded-4 shadow-sm p-4 mb-4 border-0">
        <div class="row align-items-center">
            <div class="col-auto">
                <img src="@(string.IsNullOrEmpty(Model.Logo) ? "/images/default-league.png" : $"/images/championships/{Model.Logo}")" class="rounded shadow-sm p-2 bg-light" style="width: 100px; height: 100px; object-fit: contain;">
            </div>
            <div class="col">
                <h1 class="fw-bold mb-1">@Model.ChampionshipName</h1>
                <div class="d-flex gap-3 text-muted">
                    <span><i class="bi bi-calendar3 me-1"></i> Season @Model.Season</span>
                    <span><i class="bi bi-geo-alt me-1"></i> @Model.Country</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Standings Table -->
    <div class="card shadow border-0 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="py-3" style="width: 60px;">Pos</th>
                            <th class="py-3 text-start ps-4">Team</th>
                            <th class="py-3">MP</th>
                            <th class="py-3 text-success">W</th>
                            <th class="py-3 text-warning">D</th>
                            <th class="py-3 text-danger">L</th>
                            <th class="py-3">GD</th>
                            <th class="py-3 fw-bold" style="background-color: rgba(255,255,255,0.1)">Pts</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int position = 1;
                            int totalTeams = Model.TeamStandings.Count;
                        }

                        @foreach (var item in Model.TeamStandings)
                        {
                            // تحديد ألوان المناطق (أول 1 بطل، أخر 2 هبوط مثلاً)
                            string rowStatusClass = "";
                            if (position == 1) rowStatusClass = "border-start border-4 border-success bg-success-light";
                            else if (totalTeams > 5 && position > totalTeams - 2) rowStatusClass = "border-start border-4 border-danger bg-danger-light";

                            <tr class="@rowStatusClass border-bottom">
                                <td class="fw-bold text-dark">
                                    <span class="badge @(position <= 3 ? "bg-primary" : "bg-light text-dark") rounded-circle" style="width: 28px; height:28px; display:inline-flex; align-items:center; justify-content:center;">
                                        @position
                                    </span>
                                </td>
                                <td class="text-start ps-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@(item.Team?.Logo ?? "/images/default-team.png")"
                                             class="rounded-circle me-3 shadow-sm border" width="35" height="35">
                                        <div>
                                            <div class="fw-bold text-dark">@item.Team?.TeamName</div>
                                            <div class="small text-muted d-none d-md-block">@item.Team?.Country</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-semibold">@(item.Played ?? 0)</td>
                                <td>@(item.Won ?? 0)</td>
                                <td>@(item.Draw ?? 0)</td>
                                <td>@(item.Lost ?? 0)</td>
                                <td class="fw-bold">
                                    <span class="@(item.GoalDifference > 0 ? "text-success" : item.GoalDifference < 0 ? "text-danger" : "")">
                                        @(item.GoalDifference > 0 ? "+" : "")@item.GoalDifference
                                    </span>
                                </td>
                                <td class="fw-bolder fs-5 text-primary">@((item.Won ?? 0) * 3 + (item.Draw ?? 0))</td>
                            </tr>
                            position++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="mt-4 d-flex gap-4 small text-muted">
        <div><span class="badge bg-success me-1">&nbsp;</span> Champions / Qualification</div>
        <div><span class="badge bg-danger me-1">&nbsp;</span> Relegation</div>
    </div>
</div>

<style>
    .bg-success-light {
        background-color: rgba(25, 135, 84, 0.04);
    }

    .bg-danger-light {
        background-color: rgba(220, 53, 69, 0.04);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0,0,0,0.02);
        transition: 0.2s;
    }

    .badge.bg-light {
        border: 1px solid #dee2e6;
    }
</style>