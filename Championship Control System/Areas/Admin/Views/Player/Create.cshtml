@model Championship_Control_System.Models.Player

@{
    ViewData["Title"] = "Add New Player";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-person-plus me-2"></i>Register New Player</h4>
                </div>
                <div class="card-body p-4 bg-light">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Fname" class="form-label fw-bold">First Name</label>
                                <input asp-for="Fname" class="form-control" placeholder="e.g. Cristiano" />
                                <span asp-validation-for="Fname" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Lname" class="form-label fw-bold">Last Name</label>
                                <input asp-for="Lname" class="form-control" placeholder="e.g. Ronaldo" />
                                <span asp-validation-for="Lname" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nationality" class="form-label fw-bold">Nationality</label>
                                <input asp-for="Nationality" class="form-control" placeholder="e.g. Portugal" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BirthDate" class="form-label fw-bold">Birth Date</label>
                                <input asp-for="BirthDate" type="date" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Position" class="form-label fw-bold">Position</label>
                                <select asp-for="Position" class="form-select" asp-items="ViewBag.Positions">
                                    <option value="">-- Select --</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="ShirtNumber" class="form-label fw-bold">Shirt #</label>
                                <input asp-for="ShirtNumber" type="number" class="form-control" placeholder="7" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TeamId" class="form-label fw-bold">Assign to Team</label>
                                <select asp-for="TeamId" class="form-select" asp-items="ViewBag.Teams">
                                    <option value="">-- Free Agent --</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Player Photo</label>
                            <input type="file" name="img" class="form-control" accept="image/*" />
                        </div>

                        <hr />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark px-5">Save Player</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}