@model IEnumerable<Championship_Control_System.Models.Team>

@{
    ViewData["Title"] = "Teams";
}

<h2 class="mb-4 text-primary fw-bold">
    Participating Clubs
</h2>

<div class="row">

    @foreach (var team in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm text-center p-3"
                 style="border-radius:15px;">

                <!-- Logo -->
                <img src="@(team.Logo ?? "/images/no-logo.png")"
                     alt="Team Logo"
                     width="90"
                     height="90"
                     class="mx-auto mb-3"
                     style="object-fit:contain;" />

                <!-- Name -->
                <h5 class="fw-bold">
                    @team.TeamName
                </h5>

                <!-- Stadium -->
                <p class="text-muted mb-3">
                    @(team.Stadium?.StadiumName ?? "No Stadium")
                </p>

            </div>

        </div>
    }

</div>
